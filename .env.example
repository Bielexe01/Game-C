# Juiz de código por IA — gateway Pherseus (modelos Anthropic).
# Copie este arquivo para .env e cole SUA CHAVE em GATEWAY_KEY.
# A chave é lida APENAS pelo servidor de desenvolvimento (middleware em
# server/judgeMiddleware.js) — nunca vai para o JavaScript do navegador.

GATEWAY_URL=https://api.pherseus.dev
GATEWAY_KEY=cole_sua_chave_aqui
GATEWAY_MODEL=opus-5-5
